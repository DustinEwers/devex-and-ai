# Microsoft Entra ID (Azure AD) Authentication Configuration
# Copy this file to .env.local and fill in your values

# Frontend Application (Client) ID from Azure Entra app registration
VITE_ENTRA_CLIENT_ID=your-client-id-here

# Authority URL - use one of the following:
# For single tenant: https://login.microsoftonline.com/{tenant-id}/v2.0
# For multi-tenant: https://login.microsoftonline.com/common/v2.0
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common/v2.0

# Redirect URI - must match the redirect URI registered in Azure
# For local development: http://localhost:5173/
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/

# API Scope - format: api://{api-client-id}/scope-name
# Example: api://12345678-1234-1234-1234-123456789012/user_impersonation
# Or use /.default: {api-client-id}/.default
VITE_ENTRA_API_SCOPE=api://your-api-client-id/user_impersonation

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000
